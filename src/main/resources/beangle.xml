<?xml version="1.0"?>
<beangle xmlns="http://beangle.github.io/schema/framework"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://beangle.github.io/schema/framework http://beangle.github.io/schema/framework-1.0.xsd">
  <ems app-name="std-alert-webapp"/>

  <cdi>
    <module class="org.openurp.std.alert.web.DefaultModule"/>
    <module class="org.openurp.starter.web.ProjectModule"/>
    <module class="org.openurp.std.alert.service.ServiceModule"/>
  </cdi>

  <orm>
    <mapping class="org.openurp.std.alert.model.DefaultMapping" name="std.alert"/>
    <naming>
      <profile package="org.openurp.std.alert" pluralize="true" schema="std"/>
    </naming>
  </orm>

  <mvc>
    <profile package="org.openurp.std.alert.web.action">
      <url path="/" suffix="" style="seo"/>
      <interceptor name="web.Interceptor.hibernate"/>
      <interceptor name="web.Interceptor.security"/>
    </profile>
  </mvc>

</beangle>
